# ============================================================
# DesignSoft AI — Backend Environment
# ============================================================
# Variables compartidas por todos los servicios.
# ============================================================

# ---- Logging ----
LOG_LEVEL=info

# ---- AI Agent ----
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4-pro
AGENT_PORT=4300

# ---- CRM ----
CRM_DB_PATH=/data/crm.db
CRM_PORT=4400

# ---- Voice Engine ----
OPENAI_API_KEY=
VOICE_ENGINE_PORT=3000

# ---- WhatsApp Worker ----
WHATSAPP_PORT=4500
SESSION_DIR=/data/whatsapp-session
AGENT_DEPARTMENT=soporte

# ---- Inter-service URLs (usados por whatsapp-worker) ----
AI_AGENT_URL=http://ai-agent:4300
CRM_URL=http://crm:4400
VOICE_ENGINE_URL=http://voice-engine:3000
